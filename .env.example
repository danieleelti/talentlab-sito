# Copia questo file in .env e compila. Il .env NON va su GitHub (è in .gitignore): va nel vault dei segreti.

# --- Pubblicazione via FTP sull'hosting (tools/deploy.sh) ---
FTP_HOST=ftp.esempio.it
FTP_USER=
FTP_PASSWORD=
FTP_PROTOCOL=ftp                 # ftp, oppure ftps se l'hosting lo supporta
FTP_REMOTE_A=www/demo            # cartella remota della versione A «Notte e oro» (senza / finale); la prima volta una cartella di prova
FTP_REMOTE_B=www/demo-b          # cartella remota della versione B «Verde acido»
URL_A=https://www.esempio.it/demo/      # indirizzo pubblico della A (con / finale): verifica dopo il deploy e og:url nelle pagine
URL_B=https://www.esempio.it/demo-b/    # indirizzo pubblico della B

# --- Immagini con Gemini (tools/genera-immagine.mjs), facoltativo: ~0,15 $ a immagine ---
GOOGLE_GENERATIVE_AI_API_KEY=
