# Demo di restyling: non indicizzare (non deve fare concorrenza a talentlabconsulting.it)
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow"
  <FilesMatch "\.(avif|webp|jpg|png|svg|woff2|css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
<IfModule mod_mime.c>
  AddType image/avif .avif
  AddType image/webp .webp
  AddType font/woff2 .woff2
</IfModule>
DirectoryIndex index.html
Options -Indexes

# design.md per Claude Design: si scarica (non si apre nel browser), in UTF-8
<Files "design.md">
  ForceType "text/markdown; charset=utf-8"
  <IfModule mod_headers.c>
    Header set Content-Disposition "attachment; filename=\"design.md\""
    Header set Cache-Control "no-cache"
  </IfModule>
</Files>
